e="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e4" value="N" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="SERVICIO" target="R_ofrece"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="R_tiene" value="tiene" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="600.0" width="120" height="60" as="geometry" /></mxCell><mxCell id="e5" value="1" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="PROFESIONAL" target="R_tiene"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e6" value="N" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="DISP" target="R_tiene"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="R_reserva" value="reserva" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="600.0" width="120" height="60" as="geometry" /></mxCell><mxCell id="e7" value="1" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="PACIENTE" target="R_reserva"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e8" value="N" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="TURNO" target="R_reserva"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="R_corr" value="corresponde a" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="800.0" width="140" height="70" as="geometry" /></mxCell><mxCell id="e9" value="N" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="TURNO" target="R_corr"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e10" value="1" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="DISP" target="R_corr"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="R_esde" value="es de" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1040" width="120" height="60" as="geometry" /></mxCell><mxCell id="e11" value="N" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.85;entryX=0.5;entryY=0;" edge="1" parent="1" source="TURNO" target="R_esde"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e12" value="1" style="endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="SERVICIO" target="R_esde"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="R_notif" value="notifica" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="1110" width="120" height="60" as="geometry" /></mxCell><mxCell id="e13" value="1" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="TURNO" target="R_notif"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e14" value="N" style="shape=link;endArrow=none;html=1;rounded=0;fontSize=13;fontStyle=1;labelBackgroundColor=default;" edge="1" parent="1" source="NOTIF" target="R_notif"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="RNE" value="&lt;b&gt;RNE&lt;/b&gt;&lt;ul style='margin:4px 0;padding-left:16px'&gt;&lt;li&gt;Una DISPONIBILIDAD puede tener como máximo un TURNO con estado RESERVADO.&lt;/li&gt;&lt;li&gt;El SERVICIO de un turno debe pertenecer a la ESPECIALIDAD del profesional de la disponibilidad asociada.&lt;/li&gt;&lt;li&gt;horario_inicio &amp;lt; horario_fin; las disponibilidades de un mismo profesional no se superponen.&lt;/li&gt;&lt;li&gt;No se crean disponibilidades ni se reservan turnos en fechas u horarios ya pasados.&lt;/li&gt;&lt;li&gt;No se elimina una DISPONIBILIDAD con un TURNO RESERVADO ni una que ya empezó; modificar un horario es eliminarlo y crear otro.&lt;/li&gt;&lt;li&gt;Cancelación: si cancela el PACIENTE, solo si fecha_cancelacion + 24 h &amp;lt; fecha + horario_inicio de la disponibilidad; si cancela el PROFESIONAL, en cualquier momento antes de fecha + horario_inicio.&lt;/li&gt;&lt;li&gt;fecha_cancelacion, motivo_cancelacion y cancelado_por solo tienen valor si estado = CANCELADO (motivo_cancelacion es opcional).&lt;/li&gt;&lt;li&gt;Los atributos copiados toman el valor de su origen al crearse: PROFESIONAL.nombre/apellido de USUARIO; TURNO.email_profesional/fecha/horario_inicio/horario_fin de su DISPONIBILIDAD.&lt;/li&gt;&lt;li&gt;Los email se almacenan en minúsculas.&lt;/li&gt;&lt;li&gt;USUARIO.tipo ∈ {PACIENTE, PROFESIONAL} (discriminante de la especialización).&lt;/li&gt;&lt;li&gt;TURNO.estado ∈ {RESERVADO, CANCELADO, FINALIZADO}.&lt;/li&gt;&lt;li&gt;TURNO.cancelado_por ∈ {PACIENTE, PROFESIONAL}.&lt;/li&gt;&lt;li&gt;NOTIFICACIÓN.tipo ∈ {CONFIRMADO, CANCELADO}.&lt;/li&gt;&lt;li&gt;NOTIFICACIÓN.estado_notificacion ∈ {PENDIENTE, ENVIADO, FALLIDO}.&lt;/li&gt;&lt;li&gt;NOTIFICACIÓN.destinatario ∈ {PACIENTE, PROFESIONAL}; como máximo una NOTIFICACIÓN por turno, tipo y destinatario.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="10" width="520" height="340" as="geometry" /></mxCell><mxCell id="LEG" value="&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;══ doble línea: participación total&lt;br&gt;── línea simple: participación parcial&lt;br&gt;1 / N junto a cada entidad: cardinalidad&lt;br&gt;(d): especialización disjunta, total desde USUARIO&lt;br&gt;&lt;u&gt;subrayado&lt;/u&gt;: clave primaria&lt;br&gt;&lt;i&gt;&lt;font color='#7F7F7F'&gt;gris en itálica (copia)&lt;/font&gt;&lt;/i&gt;: atributo copiado de otra entidad (desnormalización entre servicios)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#F5F5F5;rounded=1;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="1220" width="380" height="130" as="geometry" /></mxCell><mxCell id="PROFESIONAL_1" value="nombre (copia)" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="PROFESIONAL"><mxGeometry y="56" width="180" height="30" as="geometry" /></mxCell><mxCell id="PROFESIONAL_2" value="apellido (copia)" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="PROFESIONAL"><mxGeometry y="86" width="180" height="30" as="geometry" /></mxCell><mxCell id="TURNO_6" value="email_profesional (copia)" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="TURNO"><mxGeometry y="206" width="200" height="30" as="geometry" /></mxCell><mxCell id="TURNO_7" value="fecha (copia)" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="TURNO"><mxGeometry y="236" width="200" height="30" as="geometry" /></mxCell><mxCell id="TURNO_8" value="horario_inicio (copia)" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="TURNO"><mxGeometry y="266" width="200" height="30" as="geometry" /></mxCell><mxCell id="TURNO_9" value="horario_fin (copia)" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="TURNO"><mxGeometry y="296" width="200" height="30" as="geometry" /></mxCell><mxCell id="NOTIF_3" value="destinatario" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="NOTIF"><mxGeometry y="116" width="180" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>