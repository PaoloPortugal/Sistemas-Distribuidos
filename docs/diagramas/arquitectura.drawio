lt;startArrow=classic;endArrow=classic;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gw" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a6" value="REST" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;startArrow=classic;endArrow=classic;edgeStyle=orthogonalEdgeStyle;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gw" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a7" value="REST (2)" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;endArrow=classic;exitX=0;exitY=0.62;entryX=1;entryY=0.62;" edge="1" parent="1" source="s2" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a8" value="publica evento" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pub" target="rmq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a9" value="consume" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;dashed=1;endArrow=classic;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="rmq" target="notif"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a10" value="SMTP" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;startArrow=classic;endArrow=classic;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="notif" target="mail"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="leg" value="&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;── comunicación sincrónica (HTTP / REST); la flecha indica quién invoca&lt;br&gt;- - - comunicación asíncrona (mensajería AMQP)&lt;br&gt;(1) REST interno: alta y baja de profesional, con compensación (ADR 002)&lt;br&gt;(2) REST interno: valida horario y servicio al reservar (ADR 006)&lt;br&gt;(3) REST interno: horarios ocupados y bloqueo al borrar un horario (ADR 003)&lt;br&gt;(4) REST interno: nombres de pacientes para la agenda; si falla, la agenda sale sin nombres (ADR 009)&lt;br&gt;Los endpoints /interno no se exponen por el gateway.&lt;br&gt;outbox: eventos guardados en la misma transacción que el turno; el Publicador, un proceso aparte, los publica con confirmación del broker (ADR 005)&lt;br&gt;bloqueos: horarios en proceso de borrado; reservar uno bloqueado responde 409 (ADR 003)&lt;br&gt;DLQ: mensajes inválidos o que superan 5 entregas (ADR 008)&lt;br&gt;BD: esquema propio de cada servicio en una única instancia de PostgreSQL; ningún servicio accede al esquema de otro&lt;br&gt;Cada servicio con API valida el JWT con la clave pública; solo Usuarios lo firma." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#999999;fillColor=#F5F5F5;rounded=1;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="660" height="215" as="geometry" /></mxCell><mxCell id="a11" value="REST (1)" edge="1" parent="1" source="s0" target="s1" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="outbox" value="outbox&lt;br&gt;bloqueos" vertex="1" parent="s2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="30" y="62" width="55" height="36" as="geometry" /></mxCell><mxCell id="pub" value="Publicador&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(misma imagen que Reservas)&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;verticalAlign=top;spacingTop=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="612" width="150" height="76" as="geometry" /></mxCell><mxCell id="dlq" value="cola + DLQ" vertex="1" parent="rmq" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#d79b00;"><mxGeometry x="36" y="48" width="90" height="28" as="geometry" /></mxCell><mxCell id="a12" value="lee el outbox" edge="1" parent="1" source="pub" target="outbox" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=default;endArrow=classic;exitX=0.5;exitY=0;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a13" value="REST (3)" edge="1" parent="1" source="s1" target="s2" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;endArrow=classic;exitX=1;exitY=0.38;entryX=0;entryY=0.38;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a14" value="REST (4)" edge="1" parent="1" source="s2" target="s0" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=default;endArrow=classic;edgeStyle=orthogonalEdgeStyle;exitX=0.1;exitY=1;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="600" /><mxPoint x="145" y="600" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>